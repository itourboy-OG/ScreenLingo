<Window x:Class="ScreenLingo.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ScreenLingo" Width="424" Height="714"
        MinWidth="400" MinHeight="590" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen" Style="{StaticResource {x:Type Window}}">
  <Grid Margin="26,24"><Grid x:Name="HomeView">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Grid.RowSpan="2"><StackPanel Margin="0,0,3,0">
      <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
        <Image Source="{StaticResource BrandLogo}" Width="46" Height="46" Margin="0,0,12,0" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
        <StackPanel Grid.Column="1"><TextBlock Text="ScreenLingo" FontSize="23" FontWeight="SemiBold" />
          <TextBlock Text="Understand what's on screen." Style="{StaticResource Caption}" Margin="0,2,0,0" /></StackPanel>
      </Grid>
      <Border x:Name="UpdateBanner" Visibility="Collapsed" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Accent}"
              BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,18" AutomationProperties.AutomationId="update-banner">
        <StackPanel x:Name="UpdateContent">
          <StackPanel Orientation="Horizontal">
            <ContentControl x:Name="UpdateSpinner" Style="{StaticResource UpdateActivity}" Margin="0,0,8,0" Visibility="Collapsed" AutomationProperties.AutomationId="update-spinner" AutomationProperties.Name="Checking for updates" />
            <TextBlock x:Name="UpdateComplete" Text="✓" Foreground="{DynamicResource Accent}" FontWeight="Bold" Margin="0,0,8,0" Visibility="Collapsed" AutomationProperties.AutomationId="update-complete" />
            <TextBlock x:Name="UpdateTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
          </StackPanel>
          <TextBlock x:Name="UpdateDetail" Style="{StaticResource Caption}" Margin="0,5,0,9" AutomationProperties.LiveSetting="Polite" />
          <ProgressBar x:Name="UpdateProgress" Minimum="0" Maximum="100" Height="6" Visibility="Collapsed" Margin="0,0,0,10" AutomationProperties.AutomationId="update-progress" />
          <WrapPanel>
            <Button x:Name="UpdateAction" Content="Download update" Click="UpdateActionClicked" Padding="10,7" Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentInk}" AutomationProperties.AutomationId="update-action" />
            <Button x:Name="UpdateLater" Content="Later" Click="UpdateLaterClicked" Padding="10,7" Margin="8,0,0,0" Visibility="Collapsed" AutomationProperties.AutomationId="update-later" />
          </WrapPanel>
        </StackPanel>
      </Border>
      <Border Background="{DynamicResource Card}" CornerRadius="14" Padding="16" Margin="0,0,0,22">
        <StackPanel><TextBlock x:Name="StatusTitle" Text="Ready when you are" FontSize="16" FontWeight="SemiBold" />
          <TextBlock x:Name="StatusDetail" Text="Choose your language, enable translation, then switch to your game or app."
                     Style="{StaticResource Caption}" Margin="0,7,0,0" MinHeight="34" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
      </Border>
      <ComboBox x:Name="Mode" SelectedValuePath="Tag" SelectionChanged="ModeChanged" Margin="0,0,0,16"
                AutomationProperties.AutomationId="translation-mode" AutomationProperties.Name="Translation mode">
        <ComboBoxItem Content="Live translation" Tag="Live" /><ComboBoxItem Content="Screenshot translation" Tag="Screenshot" />
      </ComboBox>
      <TextBlock Text="FROM" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="0,0,0,7" />
      <ComboBox x:Name="SourceLanguage" DisplayMemberPath="Name" SelectedValuePath="Code" SelectionChanged="LanguageChanged"
                AutomationProperties.AutomationId="source-language" AutomationProperties.Name="Source language" />
      <TextBlock Text="TRANSLATE TO" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="0,17,0,7" />
      <ComboBox x:Name="TargetLanguage" DisplayMemberPath="Name" SelectedValuePath="Code" SelectionChanged="LanguageChanged"
                AutomationProperties.AutomationId="target-language" AutomationProperties.Name="Translation language" />
      <Button x:Name="ToggleTranslation" Content="Enable translation" Click="ToggleClicked" Background="{DynamicResource Accent}"
              Foreground="{DynamicResource AccentInk}" FontWeight="SemiBold" FontSize="15" Margin="0,18,0,0" Padding="14,14"
              AutomationProperties.AutomationId="toggle-translation" AutomationProperties.Name="Toggle translation" />
      <TextBlock x:Name="ShortcutCaption" Text="Ctrl + Alt + T  ·  toggle from any app" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,11,0,0" />
      <TextBlock x:Name="ServiceCaption" Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,18,0,0" />
    </StackPanel></ScrollViewer>
    <Grid Grid.Row="2" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBlock x:Name="VersionCaption" Style="{StaticResource Caption}" VerticalAlignment="Center" />
      <Button x:Name="AboutButton" Grid.Column="1" Content="About" Click="AboutClicked" Margin="0,0,8,0" AutomationProperties.AutomationId="about" />
      <Button x:Name="SettingsButton" Grid.Column="2" Content="Settings" Click="SettingsClicked" AutomationProperties.AutomationId="settings" />
  </Grid>
  </Grid>
    <Border x:Name="Notice" Visibility="Collapsed" Panel.ZIndex="10" Background="{DynamicResource Backdrop}" CornerRadius="14" Padding="16" BorderBrush="{DynamicResource Accent}" BorderThickness="1" AutomationProperties.AutomationId="app-notice">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock x:Name="NoticeTitle" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,18" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
          <TextBlock x:Name="NoticeMessage" TextWrapping="Wrap" />
          <Button x:Name="DetailsToggle" Content="Show technical details" Click="DetailsClicked" Margin="0,18,0,9" HorizontalAlignment="Left" AutomationProperties.AutomationId="error-details" />
          <TextBox x:Name="NoticeDetails" Visibility="Collapsed" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" AutomationProperties.AutomationId="error-text" />
        </StackPanel></ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
          <Button Content="Copy details" Click="CopyErrorClicked" Margin="0,0,8,0" AutomationProperties.AutomationId="copy-error" />
          <Button x:Name="DismissNotice" Content="Back" Click="DismissNoticeClicked" AutomationProperties.AutomationId="dismiss-notice" />
        </StackPanel>
      </Grid>
    </Border>
    <ContentControl x:Name="DetailView" Visibility="Collapsed" AutomationProperties.AutomationId="settings-page" />
    <Grid x:Name="AboutView" Visibility="Collapsed" AutomationProperties.AutomationId="about-page">
      <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <StackPanel>
        <Image Source="{StaticResource BrandLogo}" Width="80" Height="80" HorizontalAlignment="Left" Margin="0,0,0,20" />
        <TextBlock Text="About ScreenLingo" FontSize="24" FontWeight="SemiBold" />
        <TextBlock x:Name="AboutVersion" Style="{StaticResource Caption}" Margin="0,8,0,24" />
        <TextBlock Text="Understand games and applications in your language." TextWrapping="Wrap" FontSize="17" Margin="0,0,0,20" />
        <TextBlock Text="Ctrl+Alt+T · translate or capture&#10;Ctrl+Alt+H · open ScreenLingo&#10;Ctrl+Alt+Esc · pause&#10;&#10;Minimize to keep ScreenLingo in the system tray.&#10;&#10;Live mode reads stationary text and skips moving chat. Screenshot mode freezes a menu for closer reading.&#10;&#10;Short labels can be ambiguous. Select the source language manually when needed.&#10;&#10;Exclusive full-screen and protected content depend on the game."
                   Style="{StaticResource Caption}" />
      </StackPanel>
      <Button Grid.Row="1" Content="Back" Click="BackClicked" HorizontalAlignment="Right" AutomationProperties.AutomationId="about-back" />
    </Grid>
  </Grid>
</Window>
